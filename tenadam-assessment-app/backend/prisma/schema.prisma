// Comprehensive Tenadam Assessment Database Schema
// learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== AUTHENTICATION ====================

model AccessCode {
  id                   String             @id @default(cuid())
  code                 String             @unique // Alphanumeric code (e.g., "ABC123")
  isReusable           Boolean            @default(true) // Allow multiple uses
  maxUses              Int?               // Maximum number of uses (null = unlimited)
  currentUses          Int                @default(0) // Track current usage count
  expiresAt            DateTime?          // Optional expiration
  assessmentTemplateId String?
  assessmentTemplate   AssessmentTemplate? @relation(fields: [assessmentTemplateId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Users who used this code (many-to-many relationship)
  users                User[]

  @@map("access_codes")
}

// ==================== USER MANAGEMENT ====================

model User {
  id                 String            @id @default(cuid())
  fullName           String
  email              String            @unique
  organization       String
  phoneNumber        String

  // Authentication via Access Codes (many-to-many relationship)
  accessCodes        AccessCode[]

  // Optional fields for admin users
  passwordHash       String?
  isAdmin            Boolean           @default(false)
  isActive           Boolean           @default(true)
  lastLogin          DateTime?

  // Timestamps
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Relationships
  organizationMemberships OrganizationMember[]
  assessments        Assessment[]
  assessmentAttempts AssessmentAttempt[]
  responses          Response[]
  targetedAdminNotes AdminNote[] @relation("AdminNoteTarget")
  createdAdminNotes  AdminNote[] @relation("AdminNoteCreator")
  createdAssessmentTemplates AssessmentTemplate[] @relation("CreatedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  sessions           Session[]
  progress           UserProgress?     // Added for user progress tracking

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

// ==================== ORGANIZATION MANAGEMENT ====================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  logo        String?
  industry    String?
  size        OrganizationSize?
  address     String?
  city        String?
  state       String?
  country     String?
  zipCode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  members     OrganizationMember[]
  assessments Assessment[]
  templates   AssessmentTemplate[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  permissions    Permission[]
  joinedAt       DateTime         @default(now())
  isActive       Boolean          @default(true)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

// ==================== CATEGORIES & QUESTIONS ====================

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  displayOrder  Int           @unique
  description   String?
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model Subcategory {
  id           String     @id @default(cuid())
  name         String
  displayOrder Int
  description  String?
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions    Question[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([categoryId, displayOrder])
  @@map("subcategories")
}

// ==================== ASSESSMENT TEMPLATES ====================

model AssessmentTemplate {
  id             String         @id @default(cuid())
  title          String
  description    String?
  version        String         @default("1.0")
  category       AssessmentCategory
  type           AssessmentType @default(SELF_ASSESSMENT)
  difficulty     DifficultyLevel @default(INTERMEDIATE)
  estimatedTime  Int?           // in minutes
  isPublic       Boolean        @default(false)
  isActive       Boolean        @default(true)
  maxAttempts    Int            @default(1)
  passingScore   Float?
  instructions   String?
  metadata       Json?
  tags           String[]
  createdById    String
  createdBy      User           @relation("CreatedBy", fields: [createdById], references: [id])
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relationships
  sections       AssessmentSection[]
  assessments    Assessment[]
  accessCodes    AccessCode[]

  @@map("assessment_templates")
}

model AssessmentSection {
  id                   String             @id @default(cuid())
  templateId           String
  template             AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  instructions         String?
  orderIndex           Int
  timeLimit            Int?               // in minutes
  isRequired           Boolean            @default(true)
  minScore             Float?
  maxScore             Float?
  metadata             Json?

  // Relationships
  questions            Question[]
  responses            Response[]

  @@unique([templateId, orderIndex])
  @@map("assessment_sections")
}

model Question {
  id              String            @id @default(cuid())
  questionText    String
  questionType    QuestionType      @default(LIKERT_SCALE)
  orderIndex      Int
  points          Float             @default(1.0)
  instructions    String?
  metadata        Json?

  // Category relationship
  subcategoryId   String
  subcategory     Subcategory       @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  // Legacy section relationship (optional)
  sectionId       String?
  section         AssessmentSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Question-specific data
  options         QuestionOption[]
  correctAnswers  String[]          // For storing correct answers

  // Relationships
  responses       Response[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([subcategoryId, orderIndex])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  value      String
  orderIndex Int
  isCorrect  Boolean  @default(false)

  @@unique([questionId, orderIndex])
  @@map("question_options")
}

// ==================== ASSESSMENT EXECUTION ====================

model Assessment {
  id             String             @id @default(cuid())
  title          String
  templateId     String
  template       AssessmentTemplate @relation(fields: [templateId], references: [id])
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  assignedById   String
  assignedBy     User               @relation(fields: [assignedById], references: [id])
  status         AssessmentStatus   @default(DRAFT)
  priority       Priority           @default(MEDIUM)
  dueDate        DateTime?
  instructions   String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relationships
  attempts       AssessmentAttempt[]
  invitations    AssessmentInvitation[]
  reports        AssessmentReport[]
  adminNotes     AdminNote[]

  @@map("assessments")
}

model AssessmentAttempt {
  id                String           @id @default(cuid())
  assessmentId      String
  assessment        Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  attemptNumber     Int
  status            AttemptStatus    @default(NOT_STARTED)
  startedAt         DateTime?
  completedAt       DateTime?
  submittedAt       DateTime?
  timeSpent         Int              @default(0) // in seconds
  currentSectionId  String?
  score             Float?
  maxScore          Float?
  percentageScore   Float?
  isPassed          Boolean?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relationships
  responses         Response[]
  scores            ScoreBreakdown[]

  @@unique([assessmentId, userId, attemptNumber])
  @@map("assessment_attempts")
}

model AssessmentInvitation {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  email        String
  token        String           @unique
  status       InvitationStatus @default(PENDING)
  sentAt       DateTime         @default(now())
  acceptedAt   DateTime?
  expiresAt    DateTime
  metadata     Json?

  @@unique([assessmentId, email])
  @@map("assessment_invitations")
}

model Response {
  id               String            @id @default(cuid())

  // User and Question relationship
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question          @relation(fields: [questionId], references: [id])

  // Assessment tracking (optional)
  attemptId        String?
  attempt          AssessmentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId        String?
  section          AssessmentSection? @relation(fields: [sectionId], references: [id])

  // Response data
  responseValue    String?           // Main response value (e.g., "3" for Likert scale)
  responseText     String?           // Text responses
  selectedOptions  String[]          // For multiple choice/checkbox
  points           Float?            // Score for this response
  timeSpent        Int               @default(0) // in seconds
  metadata         Json?

  // Timestamps
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, questionId])
  @@map("responses")
}

// ==================== USER PROGRESS ====================

model UserProgress {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses           Json
  completedCategories String[]
  isCompleted         Boolean   @default(false)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("user_progress")
}

// ==================== SCORING & ANALYTICS ====================

model ScoreBreakdown {
  id              String            @id @default(cuid())
  attemptId       String
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId       String?
  category        String            // e.g., "technical", "behavioral", "leadership"
  subcategory     String?
  rawScore        Float
  maxScore        Float
  percentageScore Float
  weightedScore   Float?
  rank            String?           // e.g., "Excellent", "Good", "Fair", "Poor"
  benchmarkScore  Float?
  metadata        Json?

  @@map("score_breakdowns")
}

model AssessmentReport {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reportType     ReportType @default(INDIVIDUAL)
  title          String
  summary        String?
  recommendations String[]
  strengths      String[]
  improvements   String[]
  filePath       String?
  fileUrl        String?
  isPublic       Boolean    @default(false)
  generatedAt    DateTime   @default(now())
  expiresAt      DateTime?
  metadata       Json?

  @@map("assessment_reports")
}

// ==================== NOTIFICATIONS & COMMUNICATION ====================

model Notification {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  actionUrl   String?
  isRead      Boolean            @default(false)
  priority    Priority           @default(MEDIUM)
  metadata    Json?
  createdAt   DateTime           @default(now())
  readAt      DateTime?

  @@map("notifications")
}

model AdminNote {
  id           String     @id @default(cuid())
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String?
  targetUser   User?      @relation("AdminNoteTarget", fields: [userId], references: [id])
  createdById  String
  createdBy    User       @relation("AdminNoteCreator", fields: [createdById], references: [id])
  noteType     NoteType   @default(GENERAL)
  title        String?
  content      String
  isPrivate    Boolean    @default(true)
  priority     Priority   @default(MEDIUM)
  tags         String[]
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("admin_notes")
}

// ==================== AUDIT & LOGGING ====================

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String
  resource    String    // e.g., "assessment", "user", "organization"
  resourceId  String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

// ==================== ENUMS ====================

enum OrganizationSize {
  STARTUP
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum Permission {
  CREATE_ASSESSMENTS
  EDIT_ASSESSMENTS
  DELETE_ASSESSMENTS
  VIEW_ASSESSMENTS
  MANAGE_USERS
  VIEW_REPORTS
  MANAGE_ORGANIZATION
  MANAGE_TEMPLATES
}

enum AssessmentCategory {
  TECHNICAL
  BEHAVIORAL
  LEADERSHIP
  COMMUNICATION
  PROBLEM_SOLVING
  COGNITIVE
  PERSONALITY
  SKILLS_BASED
  COMPETENCY
  PERFORMANCE
  CUSTOM
}

enum AssessmentType {
  SELF_ASSESSMENT
  PEER_REVIEW
  MANAGER_REVIEW
  THREE_SIXTY
  SKILLS_TEST
  CERTIFICATION
  INTERVIEW
  ONBOARDING
  PERFORMANCE_REVIEW
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TRUE_FALSE
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  URL
  DATE
  TIME
  RATING_SCALE
  LIKERT_SCALE
  RANKING
  FILE_UPLOAD
  DRAWING
  CODE
  ESSAY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReportType {
  INDIVIDUAL
  TEAM
  ORGANIZATION
  BENCHMARK
  ANALYTICS
}

enum NotificationType {
  ASSESSMENT_ASSIGNED
  ASSESSMENT_COMPLETED
  ASSESSMENT_DUE
  REPORT_READY
  INVITATION_SENT
  REMINDER
  SYSTEM_UPDATE
  ANNOUNCEMENT
}

enum NoteType {
  GENERAL
  PERFORMANCE
  FEEDBACK
  RECOMMENDATION
  CONCERN
  ACHIEVEMENT
}